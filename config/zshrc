# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# p10k's "context" segment detects SSH via $SSH_CONNECTION/$SSH_TTY, which are
# never set for panes on a WezTerm mux domain (config/wezterm/domains.lua): the
# shell is spawned by wezterm-mux-server on the remote host, not by a fresh
# sshd login, so a session reached that way looks indistinguishable from local.
# Nothing in the environment marks the remote case -- a pane on the pi looks
# exactly like a local one -- so the machine has to say which one it is.
#
# Default to remote and let a marker file opt a machine out: a missing warning
# is worse than a spurious one, and a new host then needs no config at all.
# Create it on whatever machine you physically sit at:
#
#   mkdir -p ~/.config/cubasepp && touch ~/.config/cubasepp/is-local
#
# _P9K_SSH_TTY must be exported alongside P9K_SSH: _p9k_init_ssh only honours a
# preset P9K_SSH when _P9K_SSH_TTY matches $TTY, and otherwise resets it to 0.
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/cubasepp/is-local" ]] ||
  export P9K_SSH=1 _P9K_SSH_TTY=$TTY

# Homebrew lives in different places per platform: /opt/homebrew on Apple
# silicon, /usr/local on Intel macs, linuxbrew on Linux. Guarded so hosts
# without brew at all (the pi) do not error on every shell startup.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew \
  /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

source $HOME/.local/share/cubasepp/config/common/cubasepp
source $HOME/.local/share/cubasepp/themes/zsh-syntax-highlighting/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh

### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

### End of Zinit's installer chunk

# Add in zsh plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab

# Add in snippets
zinit snippet OMZL::git.zsh
zinit snippet OMZL::clipboard.zsh
zinit snippet OMZL::key-bindings.zsh
zinit snippet OMZL::history.zsh
zinit snippet OMZP::git
zinit snippet OMZP::ruby
zinit snippet OMZP::rails

# Theme: Powerlevel10k
zinit ice depth=1; zinit light romkatv/powerlevel10k

zinit snippet $HOME/.local/share/cubasepp/config/common/zsh

# Load completions
autoload -Uz compinit && compinit

zinit load 'zsh-users/zsh-history-substring-search'
zinit ice wait atload'_history_substring_search_config'

zinit cdreplay -q

eval "$($HOME/.local/bin/mise activate zsh)"
eval "$(zoxide init zsh)"
if [[ -d /opt/homebrew/opt/libpq/bin ]]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Expand history references at the moment you hit space, so `!!`, `!$` and `!-2`
# turn into the real text on the command line instead of running unseen.
bindkey ' ' magic-space

# CTRL+X L: clear the screen *and* throw away the scrollback. ^L (clear-screen)
# only wipes what is visible -- scrolling back still shows everything, which is
# not what you want after a `cat` of something private or a wall of build noise.
# \e[3J is the erase-scrollback sequence; WezTerm honours it.
#
# Escape sequences go to $TTY, not stdout: a widget's stdout is not the terminal.
# `zle .clear-screen` with the leading dot always means the builtin widget, so
# renaming this function to `clear-screen` later would not turn it into an
# infinite recursion.
cubasepp-clear-screen() {
  print -rn -- $'\e[3J' >"$TTY"
  zle .clear-screen
}
zle -N cubasepp-clear-screen
bindkey '^Xl' cubasepp-clear-screen

source $HOME/.local/share/cubasepp/config/common/zsh_style

# fzf shell integration: CTRL-T (paste file path at cursor), ALT-C (cd into dir), CTRL-R (history search)
source <(fzf --zsh)
export FZF_CTRL_T_COMMAND='fd --type f --strip-cwd-prefix'
# Preview with bat, and toggle hidden files with ctrl-h
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always {}' --bind 'ctrl-h:transform:[[ ! \$FZF_PROMPT =~ hidden ]] && echo \"change-prompt(hidden> )+reload(fd --type f --strip-cwd-prefix --hidden)\" || echo \"change-prompt(> )+reload(fd --type f --strip-cwd-prefix)\"'"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Machine-specific config (PATHs, work aliases, secrets) — not tracked in the repo.
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
