include ~/.local/share/cubasepp/themes/kitty/catppuccin-mocha.conf
include ~/.kitty.custom

# Put mise shims on PATH so GUI-launched programs (e.g. open-actions overlays
# opening nvim) get node/npm without sourcing the shell. Fixes cspell-lsp 127.
env PATH=${HOME}/.local/share/mise/shims:${PATH}

font_family      Hack Nerd Font Mono
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12

background_opacity 0.9

# Padding (logical px) between terminal content and window edge
window_padding_width 5

tab_bar_edge top
tab_bar_style powerline

enable_audio_bell no

underline_hyperlinks hover
open_url_with default
detect_urls yes
url_style curly

map cmd+c        copy_to_clipboard
map cmd+v        paste_from_clipboard

# Shift+Enter -> CSI-u sequence Claude Code reads as "newline, don't submit".
# Sent directly by kitty so it passes through tmux regardless of extended-keys negotiation.
map shift+enter send_text all \x1b[13;2u
map shift+insert paste_from_clipboard
copy_on_select true

# https://sw.kovidgoyal.net/kitty/conf/#opt-kitty.macos_option_as_alt
macos_option_as_alt yes
