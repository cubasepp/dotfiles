# File system
alias ls='eza -lh --hyperlink --group-directories-first --icons=auto'
alias ll='ls'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --hyperlink --long --icons=auto --git'
alias lta='lt -a'
alias fd='fdfind'
alias cd='z'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'


# Tools
alias vim='nvim'
alias g='git'
alias d='docker'
alias bat='batcat'
alias cat='batcat --paging=never'
alias lzg='lazygit'
alias lzd='lazydocker'

alias dm='mkdir -p'
alias dr='rmdir'

# Git
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

# Suffix aliases: a bare filename as the command opens it with the right tool,
# so `README.md` does what `bat README.md` does. Written as '$EDITOR' in single
# quotes on purpose -- config/common/zsh sources this file (line 2) before
# `editor` (line 3), so the variable does not exist yet and must be expanded at
# use time, not here. It also has to stay a single word: zsh does not split the
# expansion, so an $EDITOR with arguments would be looked up as one command name.
alias -s json=batcat
alias -s md=batcat
alias -s txt=batcat
alias -s log=batcat
alias -s rb='$EDITOR'
alias -s js='$EDITOR'
alias -s html=xdg-open

# Makefile and Dockerfile cannot be suffix aliases: `alias -s` only matches what
# follows a dot, and these have no extension at all. A plain alias does the job,
# since neither name means anything as a command otherwise. Unlike a suffix
# alias this matches the bare word only -- `sub/Makefile` still needs `batcat`.
alias Makefile='batcat Makefile'
alias Dockerfile='batcat Dockerfile'

# Env files. A suffix alias only ever sees the LAST dot segment, so
# `.env.test.local` matches `local` and `.env.development` matches `development`
# -- there is no entry for `env` to be had, it is one per trailing flavour.
#
# `.env` on its own cannot be a suffix alias at all: a leading dot leaves no
# base name, so zsh does not treat it as base+suffix and just reports "command
# not found". Same plain-alias trick as Makefile above.
alias -s local=batcat
alias -s development=batcat
alias -s test=batcat
alias -s production=batcat
alias .env='batcat .env'
