# File system
alias ls='eza -lh --hyperlink --group-directories-first --icons=auto'
alias ll='ls'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --hyperlink --long --icons=auto --git'
alias lta='lt -a'
alias fd='fdfind'
alias cd='z'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'


# Tools
alias vim='nvim'
alias g='git'
alias d='docker'
alias bat='batcat'
alias cat='batcat --paging=never'
alias lzg='lazygit'
alias lzd='lazydocker'

alias dm='mkdir -p'
alias dr='rmdir'

# Git
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'
